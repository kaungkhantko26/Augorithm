{
  "name": "augorithm",
  "version": "1.4.8",
  "description": "Visual pseudocode editor, flowchart generator, and algorithm runner for macOS, Windows, and iPad",
  "main": "electron/main.js",
  "author": "Kaung Khant Ko",
  "license": "MIT",
  "homepage": "https://github.com/kaungkhantko26/Augorithm",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaungkhantko26/Augorithm.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node tests/source-generators.test.js && node tests/desktop-features.test.js",
    "pack": "electron-builder --dir --mac",
    "dmg": "electron-builder --mac dmg zip --arm64 --publish never",
    "windows": "electron-builder --win nsis zip --x64 --publish never",
    "verify:release": "node scripts/verify-release-artifacts.js"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "mm.edu.augorithm.app",
    "productName": "Augorithm",
    "artifactName": "Augorithm-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "app/**/*",
      "package.json",
      "LICENSE"
    ],
    "fileAssociations": [
      {
        "ext": "augo",
        "name": "Augorithm Project",
        "description": "Augorithm flowchart project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-augorithm-project"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "electron/after-pack.js",
    "publish": {
      "provider": "github",
      "owner": "kaungkhantko26",
      "repo": "Augorithm",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "app/assets/icons/icon-glass-1024.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "app/assets/icons/icon-glass-1024.png",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Augorithm",
      "runAfterFinish": true
    },
    "dmg": {
      "title": "Install Augorithm",
      "backgroundColor": "#071f40",
      "iconSize": 112,
      "contents": [
        {
          "x": 160,
          "y": 190,
          "type": "file"
        },
        {
          "x": 440,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 600,
        "height": 390
      }
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
